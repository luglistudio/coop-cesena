<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coop-cesena</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>/Users/gabrielelugli/coop-cesena/coop.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/gabrielelugli/coop-cesena</string>
  <!-- every day at 9:00; if the Mac was asleep it runs on wake -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/gabrielelugli/coop-cesena/aggiornamento.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gabrielelugli/coop-cesena/aggiornamento.log</string>
</dict>
</plist>
